{
  "name": "PocketBurp",
  "short_name": "PocketBurp",
  "description": "Mobile intercepting HTTP/HTTPS proxy — intercept, edit, replay, fuzz.",
  "id": "/",
  "start_url": "/?src=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#1e1e1e",
  "theme_color": "#1e1e1e",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer", "security", "utilities"],
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/icon-180.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Intercept queue", "short_name": "Intercept", "url": "/?tab=intercept" },
    { "name": "HTTP history", "short_name": "History", "url": "/?tab=history" },
    { "name": "Repeater", "short_name": "Repeater", "url": "/?tab=repeater" },
    { "name": "Scanner", "short_name": "Scanner", "url": "/?tab=scanner" }
  ]
}
